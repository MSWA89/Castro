# ── Claude API ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-opus-4-8
MAX_TOKENS=4096

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=data/castro.db
BRAIN_PATH=brain
CHROMA_PATH=data/chroma
PERSONAS_PATH=personas

# ── Session management ────────────────────────────────────────────────────────
MAX_HOT_SESSIONS=5
IDLE_TIMEOUT_SECONDS=300
MAX_CONVERSATION_HISTORY=50

# ── Memory ────────────────────────────────────────────────────────────────────
MAX_MEMORY_RESULTS=5
MEMORY_EXTRACTION_ENABLED=true

# ── Voice (future) ────────────────────────────────────────────────────────────
VOICE_ENABLED=false
TTS_ENGINE=piper
